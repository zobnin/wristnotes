<template>
  <div class="page">
    <div class="top-safe">
      <text class="back-button" onclick="exitApp">←</text>
    </div>
    <swiper class="notes-swiper" index="0" indicator="false" loop="false" @change="onNoteChanged">
      <div class="note-page" for="note in notes">
        <scroll class="text-scroll" scroll-y="true" bounces="true">
          <div class="document">
            <block for="block in note.blocks">
              <qrcode if="{{ block.type === 'qrcode' }}" class="qrcode" value="{{ block.value }}"></qrcode>
              <barcode elif="{{ block.type === 'barcode' }}" class="barcode" value="{{ block.value }}"></barcode>
              <text else class="content {{ block.type }}">
                <span class="{{ segment.style }}" for="segment in block.segments">{{ segment.text }}</span>
              </text>
            </block>
          </div>
        </scroll>
      </div>
    </swiper>
    <div class="counter-bar">
      <text class="counter">{{ currentNumber }} / {{ notes.length }}</text>
    </div>
  </div>
</template>

<script>
export default {
  private: {
    notes: "__RPKER_NOTES__",
    currentNumber: 1
  },
  onNoteChanged(event) {
    this.currentNumber = event.index + 1
  },
  exitApp() {
    this.$app.exit()
  }
}
</script>

